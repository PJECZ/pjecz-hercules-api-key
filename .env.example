# Base de datos
DB_HOST=localhost
DB_NAME=
DB_PASS=
DB_PORT=5432
DB_USER=
SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://DB_USER:DB_PASS@DB_HOST:DB_PORT/DB_NAME"

# Nombre de esta API en la bitacora y cuota diaria de consultas por defecto
API_NOMBRE=pjecz-hercules-api-key
API_KEY_CUOTA_DIARIA=1000

# Salt sirve para cifrar el ID con HashID
SALT=

# Huso horario
TZ=America/Mexico_City

# Clave INEGI del estado de Coahuila de Zaragoza
ESTADO_CLAVE=05

# Google Cloud Storage buckets
GCP_BUCKET_EDICTOS=
GCP_BUCKET_GLOSAS=
GCP_BUCKET_LISTAS_DE_ACUERDOS=
GCP_BUCKET_OFICIOS=
GCP_BUCKET_SENTENCIAS=

# Google Cloud Secret Manager
# Solo se definen para leer la configuracion desde Secret Manager (en app.yaml)
# Cada secreto se llama "{SERVICE_PREFIX}_{VARIABLE}" en minusculas
# Si un secreto no existe se usa la variable de entorno y luego el valor por defecto
# PROJECT_ID=
# SERVICE_PREFIX=
